{
  "expo": {
    "name": "FireSight",
    "slug": "firesight-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/firesight-app-icon.png",
    "scheme": "firesightmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/firesight-adaptive-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1C3F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.firesight",
      "adaptiveIcon": {
        "backgroundColor": "#0F1C3F",
        "foregroundImage": "./assets/images/firesight-adaptive-foreground.png"
      },
      "splash": {
        "image": "./assets/images/firesight-adaptive-foreground.png",
        "resizeMode": "contain",
        "backgroundColor": "#0F1C3F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/firesight-adaptive-foreground.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0F1C3F",
          "dark": {
            "backgroundColor": "#0F1C3F"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FireSight needs camera access to capture photo evidence for fire reports."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermissionText": "FireSight needs your location to accurately geotag fire reports."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E65100",
          "sounds": [
            "./assets/sounds/fire_siren.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
